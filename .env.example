# PostgreSQL ulanishi — PAROLNI o'zingiz yozing
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/vaflo?schema=public"

PORT=4000
# Production: API faqat ichkaridan ochiq bo‘lsin
HOST=127.0.0.1
NODE_ENV=development
# Frontend manzillari (vergul bilan), CORS uchun
CORS_ORIGINS="http://localhost:3000,http://localhost:3005"

# Uzun tasodifiy qatorlar (masalan: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_ACCESS_SECRET="change-me-access"
JWT_ACCESS_TTL=900
REFRESH_TTL_DAYS=30
# HTTPS yo‘q (faqat IP) bo‘lsa false; domen + HTTPS ulangach o‘chiring yoki true qiling
COOKIE_SECURE=false

# Birinchi Owner (faqat `npm run db:seed` uchun)
SEED_OWNER_LOGIN="owner@vaflo.local"
SEED_OWNER_PASSWORD="change-me-strong-password"
SEED_STORE_NAME="Demo do'kon"

# AI orqali mahsulot qo‘shish (rasmdan). Bittasining kaliti yetarli; hech biri bo‘lmasa funksiya o‘chiq (503).
# AI_PROVIDER: gemini | openrouter | claude. Bo‘sh bo‘lsa — kaliti bor birinchisi (gemini → openrouter → claude).
AI_PROVIDER=gemini

# Google Gemini — kalit: https://aistudio.google.com → Get API key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# OpenRouter — kalit: https://openrouter.ai/keys
# Model rasm (vision) va structured outputs’ni qo‘llashi kerak (openrouter.ai/models da tekshiring)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Anthropic Claude — kalit: https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# 1 bo‘lsa (faqat development) AI chaqirilmaydi, namunaviy qoralamalar qaytadi
AI_PRODUCT_DRAFT_MOCK=0
