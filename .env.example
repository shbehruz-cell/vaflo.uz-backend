# PostgreSQL ulanishi — PAROLNI o'zingiz yozing
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/vaflo?schema=public"

PORT=4000
NODE_ENV=development
# Frontend manzillari (vergul bilan), CORS uchun
CORS_ORIGINS="http://localhost:3000,http://localhost:3005"

# Uzun tasodifiy qatorlar (masalan: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_ACCESS_SECRET="change-me-access"
JWT_ACCESS_TTL=900
REFRESH_TTL_DAYS=30

# Birinchi Owner (faqat `npm run db:seed` uchun)
SEED_OWNER_LOGIN="owner@vaflo.local"
SEED_OWNER_PASSWORD="change-me-strong-password"
SEED_STORE_NAME="Demo do'kon"
